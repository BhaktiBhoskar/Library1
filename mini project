# -------- Reusable Small Window -------- #
def newWindow(self, title, fields, command, combo=False):
# Destroys any previous popup reference (safe)
if hasattr(self, "popup") and self.popup.winfo_exists():
try:
self.popup.destroy()
except:
pass
self.popup = tk.Toplevel(self.root)
self.popup.title(title)
self.popup.geometry("460x420+400+200")
self.popup.configure(bg="#caf0f8")
self.entries = {}
tk.Label(self.popup, text=title, font=("Segoe UI Black", 20), bg="#00b4d8",
fg="white", relief="flat").pack(fill="x", pady=5)
frame = tk.Frame(self.popup, bg="#caf0f8")
frame.pack(pady=20)
for i, (label, key) in enumerate(fields):
tk.Label(frame, text=f"{label}:", font=("Segoe UI Semibold", 13),
bg="#caf0f8").grid(row=i, column=0, pady=10, padx=10)
if combo and key == "option":
# create combobox for selecting column
self.option = ttk.Combobox(frame, values=("rollNo", "name", "sub"),
font=("Segoe UI", 12), state="readonly")
self.option.set("Select Field")
self.option.grid(row=i, column=1, padx=10, pady=10)
elif combo and key == "value":
# for combo mode we also need a separate entry for the value
self.value = tk.Entry(frame, font=("Segoe UI", 12), width=20, bd=2,
relief="groove")
self.value.grid(row=i, column=1, padx=10, pady=10)
else:
entry = tk.Entry(frame, font=("Segoe UI", 12), width=20, bd=2,
relief="groove")
entry.grid(row=i, column=1, padx=10, pady=10)
# store in entries dict for normal (non-combo) or update windows
self.entries[key] = entry
tk.Button(self.popup, text="Submit", command=command, bg="#00b4d8",
fg="white",
font=("Segoe UI", 14, "bold"), bd=0, relief="flat", width=15,
cursor="hand2").pack(pady=15)
def showAll(self):
try:
self.dbFun()
self.cur.execute("SELECT * FROM student")
data = self.cur.fetchall()
self.table.delete(*self.table.get_children())
for i in data:
self.table.insert('', tk.END, values=i)
except Exception as e:
messagebox.showerror("Error", f"Error: {e}")
finally:
try:
self.con.close()
except:
pass
