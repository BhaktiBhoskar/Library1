# -------- Add Student -------- #
def addFrameFun(self):
self.newWindow("Add Student", [
("Roll No", "roll"),
("Name", "name"),
("Last Name", "fname"),
("Subject", "sub"),
("Grade", "grade")
], self.addFun)
def addFun(self):
try:
rn = self.entries["roll"].get().strip()
name = self.entries["name"].get().strip()
fname = self.entries["fname"].get().strip()
sub = self.entries["sub"].get().strip()
grade = self.entries["grade"].get().strip()
if not all([rn, name, fname, sub, grade]):
messagebox.showerror("Error", "Please fill all input fields!")
return
self.dbFun()
query = "INSERT INTO student (rollNo, name, fname, sub, grade) VALUES
(%s, %s, %s, %s, %s)"
self.cur.execute(query, (rn, name, fname, sub, grade))
self.con.commit()
messagebox.showinfo("Success", f"Student {name} (Roll No: {rn}) added
successfully!")
self.showAll()
self.popup.destroy()
except Exception as e:
messagebox.showerror("Error", f"Error: {e}")
finally:
try:
self.con.close()
except:
pass
# -------- Search Student -------- #
def searchFrameFun(self):
# note: combo=True means create combobox for 'option' AND a value entry for
'value'
self.newWindow("Search Student", [("Search By", "option"), ("Value",
"value")], self.searchFun, combo=True)
def searchFun(self):
# Validate selection and perform search
opt = self.option.get().strip()
val = self.value.get().strip()
# Allowed columns
allowed = ("rollNo", "name", "sub")
if opt not in allowed:
messagebox.showerror("Error", "Please select a valid field (rollNo, name or
sub).")
return
if not val:
messagebox.showerror("Error", "Please enter a value to search.")
return
try:
self.dbFun()
query = f"SELECT * FROM student WHERE {opt}=%s"
self.cur.execute(query, (val,))
data = self.cur.fetchall()
self.table.delete(*self.table.get_children())
for i in data:
self.table.insert('', tk.END, values=i)
# close connection & popup
self.popup.destroy()
except Exception as e:
messagebox.showerror("Error", f"Error: {e}")
finally:
try:
self.con.close()
except:
pass
# -------- Update Record -------- #
def updFrameFun(self):
self.newWindow("Update Record", [
("Field (name/sub/grade)", "option"),
("New Value", "value"),
("Roll No", "roll")
], self.updFun)
def updFun(self):
opt = self.entries["option"].get().strip()
val = self.entries["value"].get().strip()
rNo = self.entries["roll"].get().strip()
if opt not in ("name", "sub", "grade"):
messagebox.showerror("Error", "Field must be one of name, sub or grade.")
return
if not (val and rNo):
messagebox.showerror("Error", "Please provide both new value and roll
number.")
return
try:
self.dbFun()
query = f"UPDATE student SET {opt}=%s WHERE rollNo=%s"
self.cur.execute(query, (val, rNo))
self.con.commit()
messagebox.showinfo("Success", f"Record Updated for Roll No {rNo}")
self.showAll()
self.popup.destroy()
except Exception as e:
messagebox.showerror("Error", f"Error: {e}")
finally:
try:
self.con.close()
except:
pass
# -------- Delete Record -------- #
def delFrameFun(self):
self.newWindow("Remove Student", [("Roll No", "roll")], self.delFun)
def delFun(self):
rNo = self.entries["roll"].get().strip()
if not rNo:
messagebox.showerror("Error", "Please enter Roll No.")
return
try:
self.dbFun()
self.cur.execute("DELETE FROM student WHERE rollNo=%s", (rNo,))
self.con.commit()
messagebox.showinfo("Success", f"Student Roll No {rNo} removed
successfully.")
self.showAll()
self.popup.destroy()
except Exception as e:
messagebox.showerror("Error", f"Error: {e}")
finally:
try:
self.con.close()
except:
pass
